# NanoGPT API key — get one at https://nano-gpt.com
NANOGPT_API_KEY=

# SearXNG instance URL (must have JSON format enabled in settings.yml).
# Use http://searxng:8080 if running via docker compose, or http://localhost:8080 for local dev.
SEARXNG_URL=http://localhost:8080

# Optional: basic-auth credentials for the SearXNG instance, in user:pass form.
# SEARXNG_AUTH=

# Single-user gate password (anything you like)
APP_PASSWORD=changeme

# 32+ char random string for cookie signing — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Optional: where SQLite lives (default ./data/avgpt.db)
DATABASE_URL=./data/avgpt.db
